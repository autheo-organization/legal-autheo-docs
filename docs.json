          "legal-agreements/gdpr-policy",
          "legal-agreements/terms-of-service"
        ]
      },
      {
        "group": "Autheo validator node sale supporting site policies (v1.0)",
        "pages": [
          "node-sale-policies/risk-notice",
          "node-sale-policies/privacy-kyc"
        ]
      },
      {
        "group": "Autheo validator node purchase and license agreement (v1.0)",
        "pages": [
          "node-sale-purchase/license-agreement",
          "node-sale-purchase/exhibit-a",
          "node-sale-purchase/exhibit-b",
          "node-sale-purchase/exhibit-c",
          "node-sale-purchase/exhibit-d",
